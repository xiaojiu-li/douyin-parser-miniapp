{
  "name": "douyin-parser",
  "version": "1.0.0",
  "private": true,
  "description": "抖音视频解析小程序 - Taro + NestJS",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "dev:server": "nest start --watch",
    "dev": "concurrently -n h5,server -c cyan,green \"pnpm:dev:h5\" \"pnpm:dev:server\"",
    "build:server": "nest build",
    "build": "pnpm build:server && pnpm build:h5",
    "start:server": "node projects/server/dist/main.js",
    "start": "node projects/server/dist/main.js",
    "lint": "eslint src --ext .ts,.tsx",
    "validate": "bash .cozeproj/scripts/validate.sh"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-html": "4.2.1",
    "@tarojs/plugin-mini-ci": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@tarojs/plugin-generator": "4.2.1",
    "axios": "^1.7.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "lucide-react-taro": "^1.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@tailwindcss/postcss": "^4.0.0",
    "@tarojs/plugin-platform-h5": "4.2.1",
    "@tarojs/vite-runner": "4.2.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/webpack-env": "^1.18.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-preset-taro": "4.2.1",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.17.0",
    "eslint-config-taro": "4.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.49",
    "react-reconciler": "^0.29.2",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "weapp-tailwindcss": "^3.5.0"
  }
}
